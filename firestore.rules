rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    function validProgress() {
      let p = request.resource.data;
      return p.keys().hasAll(['done', 'solved', 'days', 'games', 'updatedAt'])
        && p.keys().hasOnly(['done', 'solved', 'days', 'games', 'updatedAt', 'tactics', 'corrections'])
        && p.done is list && p.done.size() <= 19
        && p.done.hasOnly(['0-0','0-1','0-2','1-0','1-1','1-2','1-3','2-0','2-1','2-2','3-0','3-1','3-2','3-3','4-0','4-1','4-2','5-0','5-1'])
        && p.solved is list && p.solved.size() <= 5000
        && p.get('tactics', []) is list && p.get('tactics', []).size() <= 5000
        && p.get('corrections', []) is list && p.get('corrections', []).size() <= 5000
        && p.days is list && p.days.size() <= 5000
        && p.games is int && p.games >= 0 && p.games <= 1000000
        && p.updatedAt == request.time;
    }
    match /users/{uid}/progress/main {
      allow get: if owner(uid);
      allow create, update: if owner(uid) && validProgress();
      allow delete: if owner(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
